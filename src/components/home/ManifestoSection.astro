  */

  // 2. Main quote animation: ENTRANCE -> PAUSE -> SCATTER OUT LINE-BY-LINE (ACTIVE ONLY)
  const initCredoScatter = () => {
    let ctx = gsap.context(() => {
      // 1. Podział tekstu na linie i pojedyncze znaki
      const split = new SplitText(".text-appearing", {
        type: "lines, chars",
        charsClass: "char",
        linesClass: "line",
      });

      // Ensure lines don't mask/clip characters during vertical entrance
      gsap.set(split.lines, { overflow: "visible" });

      // 2. Główna linia czasowa powiązana ze ScrollTriggerem z przypięciem (z pinType: "transform" dla ScrollSmoother)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".manifesto-section",
          pin: true,
          pinType: "transform",
          start: "top top",
          end: "+=2000",
          scrub: 1,
          anticipatePin: 1,
        },
      });

      // --- FAZA 1: WEJŚCIE (Entrance) ---
      tl.from(split.chars, {
        y: 20,
        autoAlpha: 0,
        ease: "circ.out",
        stagger: 0.02,
        duration: 1,
      })

        // --- FAZA 2: POSTÓJ (Pause) ---
        .to({}, { duration: 1.5 });

      // --- FAZA 3: ULATNIANIE LINIA PO LINII (Scatter Out Line-by-Line) ---
      split.lines.forEach((lineEl, idx) => {
        const lineChars = Array.from(split.chars).filter((char) => lineEl.contains(char));
        if (!lineChars.length) return;

        tl.to(
          lineChars,
          {
            y: () => gsap.utils.random(-350, -600),
            x: () => gsap.utils.random(-200, 200),
            rotationX: () => gsap.utils.random(-180, 180),
            rotationY: () => gsap.utils.random(-180, 180),
            rotationZ: () => gsap.utils.random(-90, 90),
            autoAlpha: 0,
            filter: "blur(12px)",
            ease: "power2.in",
            stagger: {
              amount: 0.8,
              from: "random",
            },
            duration: 1.5,
          },
          idx === 0 ? ">" : "+=0.01",
        );
      });
    });

    document.addEventListener("astro:before-preparation", () => ctx.revert(), { once: true });
  };

  // 3. Signature stroke drawing (TEMPORARILY COMMENTED OUT FOR ISOLATED CREDO TESTING)
  /*
  const paths = document.querySelectorAll("#artist-signature .sig-path");
  if (paths.length > 0) {
    paths.forEach((path) => {
      const length = (path as SVGPathElement).getTotalLength();
