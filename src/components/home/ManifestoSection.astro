                style="fill:none"></path>
            </clipPath>
          </defs>
          <g id="signature" style="clip-path:url(#clippath)">
            <path
              id="pen"
              class="sig-path"
              d="M7.14 36.92S.15 46.57 5.6 50.69c8.24 6.23 15.96 2.48 22.59-3.47 2.74-2.47 3.83-11.66-6.18-15.06-4.99-1.7-17.13-1.17-17.44-4.48-.56-5.97 18.02-16.37 20.72-14.44s-1.8 9.52-.26 12.56c1.22 2.4 10.88-10.45 11.65-15.46s7.49-1.72 9.43 6.68c2.73 11.79-2.42 25.05 0 34.06 0 0 6.78 6.76 8.14-1.16S53.48 13.21 56.7 9c3.47-4.55 7.53.44 8.11 6.42s1.25 41.81-3.22 44.92C58.63 62.4 60.47 46.23 69.7 40c10.94-7.38 27.57-22.68 29.52-28.2s-26.23 11.76-27.2 19.77 6.92 19.99 13.4 25.35 33.7-8.41 37.95-16.78c3.87-7.63 6.97-20.8.77-25.35s-21.11 5.28-24.92 15.83c-2.95 8.15-3.01 17.37 15.53 19.31 16.17 1.68 16.86-39.05 14.03-45.46-2.4-5.44 6.83-7.03 7.95 4.84s5.95 31.49-.81 43.66-4.62-42.77 2.28-44.89 22.63 2.75 21.47 10.28-7.79 9.36-14.16 11.89-6.89 6.37-1.48 8.88 19.91 7.89 22.46 7.02c5.15-1.75-7.28-25.06-4.5-34.32s31.4-14.11 32.18-7.97-11 7.4-16.6 9.14-10.55 6.31 3.35 9.72 15.32 7.73 10.55 11.78c-4.41 3.75-10.17 5.92-17.25 8.47-5.59 2.01 19.43 4.41 22.91-2.22s-1.16-37.5 3.28-42.24 6.37-2.04 7.72 8.39 4.4 37.68-1.2 43.14-3.73-12.92 9.25-21.49 22.66-14.77 25.17-20.32-23.76 2.03-23.37 10.14 6.18 19.22 14.91 26.31c4.97 4.03 10.57-20.95 11.15-27.63s1.42-26.96 7.4-16.24.32 34.66-1.8 43.15"
              stroke="currentColor"
              stroke-width="10px"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </g>
        </svg>
      </div>
    </div>

    <!-- Three Pillars & Story Link aligned to right -->
    <div class="mt-auto w-full pt-6">
      <!-- 3 separate boxes -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left mb-6 md:mb-8">
        <!-- Box 1 -->
        <div class="creed-box bg-[rgba(244,240,234,0.03)] p-6 md:p-8 backdrop-blur-sm">
          <div class="space-y-2.5">
            <h3 class="creed-box-title text-lg" style="color: var(--dim-grey-light) !important;">
              30 Years of Heritage
            </h3>
            <p class="creed-box-desc text-[13px] text-[var(--dim-grey-light)] leading-relaxed">
              Decades of mastering traditional drawing techniques and preserving classical
              craftsmanship.
            </p>
          </div>
        </div>

        <!-- Box 2 -->
        <div class="creed-box bg-[rgba(244,240,234,0.03)] p-6 md:p-8 backdrop-blur-sm">
          <div class="space-y-2.5">
            <h3 class="creed-box-title text-lg" style="color: var(--dim-grey-light) !important;">
              1/1 Unique Originals
            </h3>
            <p class="creed-box-desc text-[13px] text-[var(--dim-grey-light)] leading-relaxed">
              Absolute absence of print-on-demand editions, digital replicas, or duplicates. Each
              piece is unique.
            </p>
          </div>
        </div>

        <!-- Box 3 -->
        <div class="creed-box bg-[rgba(244,240,234,0.03)] p-6 md:p-8 backdrop-blur-sm">
          <div class="space-y-2.5">
            <h3 class="creed-box-title text-lg" style="color: var(--dim-grey-light) !important;">
              Archival Standards
            </h3>
            <p class="creed-box-desc text-[13px] text-[var(--dim-grey-light)] leading-relaxed">
              Museum-grade acid-free cotton papers (Canson/Strathmore) paired with archival media to
              last for centuries.
            </p>
          </div>
        </div>
      </div>

      <!-- Link with animated underline placed BELOW the 3 boxes grid with clean separation -->
      <div class="flex justify-end pt-1 pb-1">
        <a
          href="/about"
          class="group relative inline-flex items-center gap-1.5 text-[13px] text-[var(--dim-grey-light)] hover:text-[var(--old-lace)] transition-colors pb-1"
        >
          Read the story
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          <span
            class="absolute bottom-0 left-0 w-full h-[1px] bg-[var(--sanguine)] origin-right scale-x-0 transition-transform duration-300 group-hover:scale-x-100 group-hover:origin-left"
          ></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .smoke-title,
  .manifesto-text {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  /* Stylizacja i mikro-animacje 3 filarów */
  .creed-box {
    transition: background-color 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid transparent;
  }

  .creed-box:hover {
    background-color: rgba(244, 240, 234, 0.06);
    border-color: rgba(142, 74, 56, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5), 0 0 20px rgba(142, 74, 56, 0.15);
  }

  .creed-box-title {
    font-weight: 400;
    font-variation-settings: "wght" 400;
    transition: font-weight 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                font-variation-settings 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.8s ease,
                letter-spacing 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .creed-box:hover .creed-box-title {
    font-weight: 900 !important;
    font-variation-settings: "wght" 900 !important;
    color: #ffffff !important;
    letter-spacing: 0.035em;
  }

  /* Wymuszamy, by żaden kontener podziału nie obcinał wystających elementów */
  .smoke-title,
  .manifesto-text,
  :global(.smoke-title .line),
  :global(.manifesto-text .line),
  :global(.smoke-title .char),
  :global(.manifesto-text .char) {
    overflow: visible !important;
  }

  /* Powiększamy obszar renderowania znaku bez zmieniania jego pozycji w tekście */
  :global(.smoke-title .char),
  :global(.manifesto-text .char) {
    display: inline-block;
    padding: 0.15em 0.2em; /* Daje przestrzeń na ozdobniki i ligatury */
    margin: -0.15em -0.2em; /* Kompensuje padding, zachowując naturalne odległości */

    /* Włącza antyaliasing i poprawia renderowanie krawędzi w 3D */
    backface-visibility: hidden;
    -webkit-font-smoothing: antialiased;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  const initManifestoAnimation = async () => {
    // 1. Czekamy, aż fonty będą gotowe i wyrenderowane!
    if (document.fonts) {
      await document.fonts.ready;
    }

    // 2. Bezpieczny kontekst GSAP
    let ctx = gsap.context(() => {
      const titleEl = document.querySelector(".smoke-title") || document.querySelector(".manifesto-text");
      if (!titleEl) return;

      const split = new SplitText(titleEl, {
        type: "lines, chars",
        charsClass: "char",
        linesClass: "line"
      });

      gsap.set(split.lines, { overflow: "visible" });

      const sectionEl = (document.querySelector(".smoke-section") || document.querySelector(".manifesto-section")) as HTMLElement | null;
      if (!sectionEl) return;

      const creedTag = sectionEl.querySelector(".artist-creed-tag") as HTMLElement | null;
      const creedLine = sectionEl.querySelector(".creed-line") as HTMLElement | null;

      // Obliczenia wysokości pionowej linii dla pozycji startowej (wyżej na 25vh) oraz pozycji docelowej na samej górze
      const sectionRect = sectionEl.getBoundingClientRect();
      const tagRect = creedTag ? creedTag.getBoundingClientRect() : null;
      const baseTagTop = tagRect ? tagRect.top - sectionRect.top : 80;
      const vhOffset = window.innerHeight * 0.25;
      const heightAtStartPos = Math.max(40, baseTagTop + vhOffset);
      const heightAtZero = Math.max(40, baseTagTop);

      // 0. Linia zaczyna rysować się w dół WIRALOWO / WCZEŚNIEJ – dokładnie gdy góra sekcji znajdzie się na wysokości 50vh (top 50%)
      if (creedLine) {
        gsap.set(creedLine, {
          height: heightAtStartPos,
          scaleY: 0,
          transformOrigin: "top center",
          opacity: 1,
        });

        gsap.to(creedLine, {
          scaleY: 1,
          ease: "none",
          scrollTrigger: {
            trigger: sectionEl,
            start: "top 50%",
            end: "top top",
            scrub: 1,
          },
        });
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: sectionEl,
          pin: true,
          pinType: "transform",
          start: "top top",
          end: "+=4000",
          scrub: 1,
          anticipatePin: 1,
        }
      });

      // 1a. Nagłówek schodzi się na 25vh (letter-spacing 3.5em -> 0.3em)
      if (creedTag && creedLine) {
        tl.fromTo(
          creedTag,
          {
            autoAlpha: 0,
            y: "25vh",
            letterSpacing: "3.5em",
            textShadow: "0 0 0px rgba(224, 72, 54, 0)",
          },
          {
            autoAlpha: 1,
            y: "25vh",
            letterSpacing: "0.3em",
            duration: 1.4,
            ease: "power2.out",
          }
        );

        // 1b. Gdy zbieganie się liter dobiegnie końca: płynne włączenie jasnego cienia (textShadow glow) oraz przesunięcie w górę
        tl.to(
          creedTag,
          {
            textShadow: "0 0 12px #ff5c47, 0 0 28px #e04836, 0 0 55px #e04836, 0 0 90px rgba(224, 72, 54, 0.95)",
            y: 0,
            duration: 1.2,
            ease: "power2.inOut",
          },
          "+=0.05"
        );

        tl.to(
          creedLine,
          {
            height: heightAtZero,
            duration: 1.2,
            ease: "power2.inOut",
          },
          "<"
        );
      }

      // 2. Credo - wejście tekstu
      tl.from(split.chars, {
        y: 20,
        autoAlpha: 0,
        ease: "circ.out",
        stagger: 0.02,
        duration: 1
      }, "-=0.3");

      // 3. Animacja rysowania podpisu SVG (Artist Signature)
      const sigPaths = sectionEl.querySelectorAll("#artist-signature .sig-path");
      if (sigPaths.length > 0) {
        sigPaths.forEach((path) => {
          const length = (path as SVGPathElement).getTotalLength();
          gsap.set(path, {
            strokeDasharray: length,
            strokeDashoffset: length,
          });
        });

        tl.to(
          sigPaths,
          {
            strokeDashoffset: 0,
            duration: 1.5,
            ease: "power2.inOut",
            stagger: 0.2,
          },
          "-=0.2"
        );
      }

      // 4. Postój przed pojawieniem się boxów filarów
      tl.to({}, { duration: 2.0 });

      // 5. Czysta animacja wejścia 3 boxów filarów oraz linku [Read the story →] (bez modyfikowania struktury DOM)
      const boxes = sectionEl.querySelectorAll(".creed-box");
      if (boxes.length > 0) {
        tl.from(
          boxes,
          {
            y: 30,
            autoAlpha: 0,
            duration: 1.0,
            stagger: 0.35,
            ease: "power2.out"
          }
        );
      }

      const storyLink = sectionEl.querySelector("a[href='/about']");
      if (storyLink) {
        tl.from(
          storyLink,
          {
            y: 20,
            autoAlpha: 0,
            duration: 0.8,
            ease: "power2.out"
          },
          "-=0.3"
        );
      }

      // Postój przed ulatnianiem tekstu
      tl.to({}, { duration: 2.0 });

      // 6a. Napis THE ARTIST CREED oraz linia znikają tuż przed credo
      if (creedTag) {
        tl.to(
          creedTag,
          {
            autoAlpha: 0,
            y: -20,
            duration: 0.8,
            ease: "power2.in",
          }
        );
      }

      if (creedLine) {
        tl.to(
          creedLine,
          {
            autoAlpha: 0,
            duration: 0.6,
            ease: "power2.in",
          },
          "<"
        );
      }

      // 6b. Credo zaczyna zanikać (Scatter Out Line-by-Line 3D)
      split.lines.forEach((lineEl, idx) => {
        const lineChars = Array.from(split.chars).filter((char) => lineEl.contains(char));
        if (!lineChars.length) return;

        tl.to(
          lineChars,
          {
            y: () => gsap.utils.random(-350, -600),
            x: () => gsap.utils.random(-200, 200),
            rotationX: () => gsap.utils.random(-180, 180),
            rotationY: () => gsap.utils.random(-180, 180),
            rotationZ: () => gsap.utils.random(-90, 90),
            autoAlpha: 0,
            filter: "blur(12px)",
            ease: "power2.in",
            stagger: {
              amount: 0.8,
              from: "random",
            },
            duration: 1.5,
          },
          idx === 0 ? ">" : "-=1.25",
        );
      });

      // 7. Podpis znika po ulatnieniu się credo
      const sigEl = sectionEl.querySelector("#artist-signature");
      if (sigEl) {
        tl.to(
          sigEl,
          {
            autoAlpha: 0,
            y: -20,
            duration: 1,
            ease: "power2.in",
          },
          "-=0.4"
        );
      }
    });

    // 3. KLUCZOWE: Wymuszamy ponowne przeliczenie ScrollTriggera po zmianie DOM i załadowaniu fontów
    ScrollTrigger.refresh();

    return ctx;
  };

  // Obsługa cyklu życia Astro (dla zwykłego ładowania i View Transitions)
  const setupLifecycle = () => {
    let ctxPromise = initManifestoAnimation();

    const cleanup = async () => {
      const ctx = await ctxPromise;
      if (ctx) ctx.revert();
    };

    document.addEventListener("astro:before-preparation", cleanup, { once: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLifecycle);
  } else {
    setupLifecycle();
  }

  document.addEventListener("astro:page-load", setupLifecycle);
</script>

