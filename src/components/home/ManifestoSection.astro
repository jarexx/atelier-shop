              stroke="currentColor"
              stroke-width="10px"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </g>
        </svg>
      </div>
    </div>

    <!-- Three Pillars & Story Link aligned to right -->
    <div class="mt-auto w-full pt-6">
      <!-- 3 separate boxes with NO light borders -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left mb-4"
        data-stagger-grid
        data-stagger-start="top 65%"
      >
        <!-- Box 1 -->
        <div class="bg-[rgba(244,240,234,0.03)] p-6 md:p-8 backdrop-blur-sm">
          <div class="space-y-2.5">
            <h3 class="text-lg" style="color: var(--dim-grey-light) !important;">
              30 Years of Heritage
            </h3>
            <div class="text-[13px] text-[var(--dim-grey-light)] leading-relaxed">
              Decades of mastering traditional drawing techniques and preserving classical
              craftsmanship.
            </div>
          </div>
        </div>

        <!-- Box 2 -->
        <div class="bg-[rgba(244,240,234,0.03)] p-6 md:p-8 backdrop-blur-sm">
          <div class="space-y-2.5">
            <h3 class="text-lg" style="color: var(--dim-grey-light) !important;">
              1/1 Unique Originals
            </h3>
            <div class="text-[13px] text-[var(--dim-grey-light)] leading-relaxed">
              Absolute absence of print-on-demand editions, digital replicas, or duplicates. Each
              piece is unique.
            </div>
          </div>
        </div>

        <!-- Box 3 -->
        <div class="bg-[rgba(244,240,234,0.03)] p-6 md:p-8 backdrop-blur-sm">
          <div class="space-y-2.5">
            <h3 class="text-lg" style="color: var(--dim-grey-light) !important;">
              Archival Standards
            </h3>
            <div class="text-[13px] text-[var(--dim-grey-light)] leading-relaxed">
              Museum-grade acid-free cotton papers (Canson/Strathmore) paired with archival media to
              last for centuries.
            </div>
          </div>
        </div>
      </div>

      <!-- Link with animated underline -->
      <div class="flex justify-end">
        <a
          href="/about"
          class="group relative inline-flex items-center gap-1.5 text-[13px] text-[var(--dim-grey-light)] hover:text-[var(--old-lace)] transition-colors pb-1"
        >
          Read the story
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          <span
            class="absolute bottom-0 left-0 w-full h-[1px] bg-[var(--sanguine)] origin-right scale-x-0 transition-transform duration-300 group-hover:scale-x-100 group-hover:origin-left"
          ></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-text {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  :global(.manifesto-text .line) {
    overflow: visible !important;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // 1. Vertical Line drawing (TEMPORARILY COMMENTED OUT FOR ISOLATED CREDO TESTING)
  /*
  const manifestoSection = document.querySelector(".manifesto-section");
  const creedTag = document.querySelector(".artist-creed-tag") as HTMLElement | null;
