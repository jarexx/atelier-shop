        strokeDasharray: length,
        strokeDashoffset: length,
      });
    });

    gsap.to(paths, {
      strokeDashoffset: 0,
      duration: 3.2,
      ease: "power2.inOut",
      stagger: 0.25,
      scrollTrigger: {
        trigger: "#artist-signature",
        start: "top 65%",
        toggleActions: "play none none none",
      },
    });
  }
  */

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCredoScatter);
  } else {
    initCredoScatter();
  }
</script>
