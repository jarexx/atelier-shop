<section class="manifesto-section relative min-h-[70vh] flex items-center justify-center bg-charcoal-texture text-[var(--old-lace)] px-6 py-24 overflow-hidden z-10">
  <div class="mx-auto w-full max-w-4xl text-center space-y-12 z-10">
    <p class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-[var(--dim-grey-light)] font-medium">
      THE ARTIST CREED
    </p>
    
    <div class="space-y-6">
      <h2 class="manifesto-text text-3xl sm:text-5xl lg:text-6xl font-serif leading-[1.2] text-balance font-normal tracking-wide">
