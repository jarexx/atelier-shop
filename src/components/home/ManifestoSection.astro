---

---

<section
  class="manifesto-section relative h-screen min-h-screen flex items-center justify-center bg-charcoal-texture text-[var(--old-lace)] px-6 py-12 z-10 overflow-hidden"
>
  <!-- Thin vertical line extending from top edge of section down to touch tagline (temporarily hidden for isolation testing) -->
  <!-- <div
    class="creed-line absolute top-0 left-1/2 -translate-x-1/2 w-[1px] bg-[var(--sanguine)] opacity-80 pointer-events-none origin-top overflow-hidden"
  >
  </div> -->

  <div
    class="mx-auto w-full max-w-5xl text-center flex flex-col justify-between min-h-[600px] space-y-12 z-10"
  >
    <div class="space-y-6 pt-12 w-full flex flex-col items-center">
      <!-- Animated Tagline -->
      <p
        class="artist-creed-tag text-[10px] md:text-xs uppercase tracking-[0.3em] text-[var(--dim-grey-light)] font-medium"
      >
        THE ARTIST CREED
      </p>

      <h2
        class="text-appearing manifesto-text text-3xl sm:text-5xl lg:text-6xl font-serif leading-[1.35] text-balance font-normal tracking-wide max-w-4xl mx-auto pt-6"
      >
        “Every stroke is an unfiltered dialogue between charcoal and paper. No mass prints, no
        digital replication. Only single-edition physical artwork crafted to endure for centuries.”
      </h2>

      <!-- Artist SVG Signature aligned right with larger gap below -->
      <div class="pt-6 pb-8 flex justify-end w-full max-w-4xl h-24">
        <svg
          id="artist-signature"
          viewBox="0 0 258.67 56.92"
          class="w-36 h-12 text-[var(--sanguine)] opacity-90 mr-4 md:mr-12"
          fill="none"
