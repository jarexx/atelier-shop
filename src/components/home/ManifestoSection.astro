---

---

<section
  class="manifesto-section smoke-section relative h-screen min-h-screen flex items-center justify-center bg-charcoal-texture text-[var(--old-lace)] px-6 py-12 z-10 overflow-hidden"
>
  <!-- Thin vertical line extending from top edge of section down to touch tagline -->
  <div
    class="creed-line absolute top-0 left-1/2 -translate-x-1/2 w-[1px] bg-[var(--sanguine)] opacity-80 pointer-events-none origin-top overflow-hidden"
  >
  </div>

  <div
    class="mx-auto w-full max-w-5xl text-center flex flex-col justify-between min-h-[600px] space-y-12 z-10"
  >
    <div class="space-y-6 pt-12 w-full flex flex-col items-center">
      <!-- Animated Tagline -->
      <p
        class="artist-creed-tag text-[10px] md:text-xs uppercase tracking-[0.3em] text-[var(--dim-grey-light)] font-medium"
      >
        THE ARTIST CREED
      </p>

      <h2
        class="text-appearing manifesto-text smoke-title text-3xl sm:text-5xl lg:text-6xl font-serif leading-[1.35] text-balance font-normal tracking-wide max-w-4xl mx-auto pt-6"
      >
        “Every stroke is an unfiltered dialogue between charcoal and paper. No mass prints, no
        digital replication. Only single-edition physical artwork crafted to endure for centuries.”
      </h2>

      <!-- Artist SVG Signature aligned right with larger gap below -->
      <div class="pt-6 pb-8 flex justify-end w-full max-w-4xl h-24">
        <svg
          id="artist-signature"
          viewBox="0 0 258.67 56.92"
          class="w-36 h-12 text-[var(--sanguine)] opacity-90 mr-4 md:mr-12"
          fill="none"
        >
          <defs>
            <clipPath id="clippath">
              <path
                d="M144.81 34.87c.49-3.15 6.77-4.31 9.71-5.78 3.06-1.32 5.67-2.54 7.3-5.13 11.62-16.2-36.65-30.27-28.64-7.9 4.65 11.55-3.98 30.53 2.72 36.9 2.7 1.26 4.93-3.04 5.31-5.49.72-1.89-1.52-5.85 1.63-5.46 3.88.71 18.83 7.68 20.42 3.14-.18-1.12-1.47-1.85-2.4-2.34-3.77-1.91-9.2-3.92-13.05-5.59-1.07-.51-2.69-1.12-3.01-2.34Zm-1.92-8.37c-13.98-27.98 20.92-16.71 11.59-5.3-2.23 2.62-8.46 9.11-11.59 5.3M95.52 43.69c-3.82-4.78-2.2-11.55.59-15.29 7.74-10.38 15.48-14.67 20.6-16.6 23.25-8.79 10.99 49.98-10.67 40.18-3.29-1.49-7.91-5.04-10.52-8.3Zm25.3-6.08c3.13-4.37 6.47-11.44 4.63-16.6-1.82-4.81-8.01-5.6-14.19-.52-18.68 14.75-7.92 38.47 9.55 17.12ZM27.49 52.32c-12.26 9.91-39.12-2.63-21.87-11.41 1.06-.58 2.94-1.38 2.24.42-8.97 14.88 14.81 14.09 18.44.36 3.16-15.92-39.1-1.79-21.65-20.72 3.67-3.98 8.13-6.14 13.38-9.06C33.36 3.4 31.28 25.29 23.8 24.66c-2.34-.89-.03-3.55.22-5.1.82-5.1-12.17.39-15.53 4.6-.74.93-.37 2.32.76 2.69 10.92 3.68 36.45 5.11 18.23 25.46Zm198.69-22.64c.99 3.67 5.17 7.44 6.39 11.24 2.5 8.63-5.25 2.12-7.68-.6-6.46-7.22-7.4-9.85-11.35-2.11-1.75 3.42-1.53 11.99-7.18 10.01-.85-.6-1.04-1.62-1.06-2.42-.28-7.86.53-16.63.14-23.72-.09-4.87-3.64-19.36 1.52-21.31 9.76.41 1.24 19.08 7.69 22.42 6.24 4.47 23.77-23.53 28.29-13-.83 9.45-19.34 9.85-16.75 19.48ZM79.15 36.24c-3.98 6.16 10.93 20.05 6.27 20.68-6.14-.26-12.11-17.68-17.46-9.07-1.74 3.02-3.41 12.63-7.61 6.41-2.26-4.22.36-9.02.49-13.28.9-7.76-1.28-30.44 3.04-30.65.92-.05 2.5 1.98 3.25 4.06 2.47 5.81-3.64 30.63 8.79 17.54 5.64-5.25 11.51-12.08 16.9-17.2 1.51-1.49 7.26-3.12 6.3.48-3.16 7.02-15.45 14.8-19.96 21.03Zm118.33-8.72c4.03 8.1-10.6 15.96-17.62 15.4-3.13.09-7.68-1.15-2.98-4.5 3.2-2.38 8.35-4.04 11.27-6.96 7.13-7.96-18.74-3.59-20.6-14.21.37-6.57 12.24-9.32 17.67-8.42 3.82.53 6.96 2.85 3.53 4.41-1.22.95-14.84 2.35-11.66 5.5 5.97 2.8 16.38 1.93 20.39 8.78m53.13 13.16c-1.36.27-2.24-1-2.3-2.25-1.5-11.03 3.97-22.74.44-33.49-2.38-8.7 11.78-6.46 9.71 11.1-.17 5.18-2.6 23.83-7.85 24.64m-202.03 4c-.48 2.26 1.05 7.41