---
import { Image } from "astro:assets";
import grzegorzImg from "@/assets/images/products/dla_grzegorza.webp";
import glassesImg from "@/assets/images/products/woman-in-glasses.webp";
import paraImg from "@/assets/images/portraits/para2_1.avif";

const privateCollectionItems = [
  {
    image: grzegorzImg,
    alt: "Portret dla Grzegorza",
    classes: "max-w-[350px] lg:self-start self-center lg:ml-16"
  },
  {
    image: glassesImg,
    alt: "Portret kobiety w okularach",
    classes: "max-w-[350px] lg:self-end self-center lg:-mt-8"
  },
  {
    image: paraImg,
    alt: "Portret pary",
    classes: "max-w-[560px] self-center lg:mt-4"
  }
];
---

<section id="commissions" class="commissions-section relative bg-charcoal-texture text-[var(--old-lace)] px-6 py-24 md:py-36 z-10">
  <div class="mx-auto w-full max-w-screen-xl grid grid-cols-1 lg:grid-cols-12 gap-16 items-start z-10">
    
    <!-- Lewa kolumna: Informacje o zamówieniach (przypięte/sticky) -->
    <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-8 z-10">
      <div class="section-header space-y-4" data-section-header>
        <p class="section-tag text-[10px] md:text-xs uppercase tracking-[0.3em] text-[var(--dim-grey-light)] font-medium">
          Portrety na zamówienie
        </p>
        <h2 
          class="section-title text-4xl sm:text-5xl lg:text-6xl font-serif text-[var(--old-lace)] leading-tight tracking-tight"
          style="font-weight: 400; font-variation-settings: 'wght' 400;"
        >
          Commission<br /><span class="italic text-[var(--dim-grey-light)]">Portraits</span>
        </h2>
      </div>

      <div class="space-y-6 text-sm text-[var(--dim-grey-light)] leading-relaxed">
        <p>
          Zamów indywidualny, ręcznie wykonany portret. Każde zlecenie realizowane jest zgodnie z muzealnymi standardami z użyciem najwyższej jakości, bezkwasowych materiałów, dostosowanych do Twoich oczekiwań.
        </p>
        <p>
          Pracuję bezpośrednio na podstawie dostarczonych przez Ciebie fotografii wysokiej rozdzielczości. Przed nałożeniem finalnego światłocienia przesyłam roboczy szkic do Twojej weryfikacji i akceptacji.
        </p>
      </div>

      <!-- Szczegóły techniczne/biznesowe -->
      <div class="border-t border-[var(--dim-grey-light)]/25 pt-6 space-y-4 text-xs font-sans text-[var(--dim-grey-light)]">
        <div class="flex justify-between text-balance gap-4">
          <span class="uppercase tracking-[0.1em] shrink-0">Formaty</span>
          <span class="text-[var(--old-lace)] font-medium text-right">A3 / A3+ / Wymiary niestandardowe</span>
        </div>
        <div class="flex justify-between text-balance gap-4">
          <span class="uppercase tracking-[0.1em] shrink-0">Płatność</span>
          <span class="text-[var(--old-lace)] font-medium text-right">Zadatek 50% przed rozpoczęciem pracy</span>
        </div>
        <div class="flex justify-between text-balance gap-4">
          <span class="uppercase tracking-[0.1em] shrink-0">Wysyłka</span>
          <span class="text-[var(--old-lace)] font-medium text-right">Bezpieczne opakowanie w tubach tubusowych</span>
        </div>
      </div>

      <div class="pt-4">
        <a
          href="/kontakt"
          class="inline-flex items-center justify-center gap-3 rounded-full bg-[var(--old-lace)] text-[var(--charcoal-black)] px-8 py-4 text-xs font-semibold uppercase tracking-[0.2em] transition-all hover:bg-[#eae1d4] hover:scale-[1.01] active:scale-[0.99]"
        >
          Napisz w sprawie zamówienia
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Prawa kolumna: Pionowy stos rysunków o asymetrycznym ułożeniu -->
    <div class="lg:col-span-7 space-y-12 z-10 flex flex-col w-full">
      <p class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-[var(--dim-grey-light)] font-medium self-start">
        Rysunki
      </p>

      <div class="flex flex-col gap-16 w-full">
        {
          privateCollectionItems.map((item) => (
            <div class={`commissions-tile group w-full ${item.classes}`}>
              <div class="relative overflow-hidden bg-[#221c16] rounded-sm p-3 border border-[var(--dim-grey-light)]/20 shadow-md">
                <div class="relative w-full overflow-hidden bg-[#2d2822]">
                  <Image
                    src={item.image}
                    alt={item.alt}
                    width={800}
                    format="webp"
                    loading="lazy"
                    class="w-full h-auto object-contain transition-transform duration-[1200ms] group-hover:scale-[1.01]"
                  />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const container = document.querySelector("#commissions .section-header");
  if (container) {
    const tag = container.querySelector(".section-tag");
    const title = container.querySelector(".section-title");

    if (title) {
      const headerTl = gsap.timeline({
        scrollTrigger: {
          trigger: container,
          start: "top 90%",
          end: "top 35%",
          scrub: 1,
        },
      });

      if (tag) {
        headerTl.fromTo(
          tag,
          { y: 20, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 1.0, ease: "power2.out" }
        );
      }

      headerTl.fromTo(
        title,
        {
          y: 28,
          autoAlpha: 0,
          fontWeight: 400,
          fontVariationSettings: "'wght' 400",
        },
        {
          y: 0,
          autoAlpha: 1,
          duration: 1.1,
          ease: "power2.out",
        },
        tag ? "-=0.7" : 0
      );

      headerTl.to(
        title,
        {
          fontWeight: 900,
          fontVariationSettings: "'wght' 900",
          duration: 1.5,
          ease: "power2.inOut",
        },
        "-=0.2"
      );
    }
  }
</script>
