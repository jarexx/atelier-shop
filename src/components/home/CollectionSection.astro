---
import { Image } from "astro:assets";
import quietImg from "@/assets/images/products/quiet-in-a-white-dress.webp";
import sittingImg from "@/assets/images/products/sitting-back-woman.webp";
import sunraysImg from "@/assets/images/products/sunrays-on-the-blue-sea.webp";
import mckennaImg from "@/assets/images/products/mckenna-hellam.webp";
import pensiveImg from "@/assets/images/products/pensive-moment.webp";
import sideImg from "@/assets/images/products/naked-woman-on-her-side.webp";

const collectionItems = [
  {
    slug: "quiet-in-a-white-dress",
    name: "Quiet in a white dress",
    image: quietImg,
    aspect: "aspect-[3/4]",
    widthClass: "w-[270px] md:w-[370px]",
    offset: "translate-y-0"
  },
  {
    slug: "sitting-back-woman",
    name: "Sitting back woman",
    image: sittingImg,
    aspect: "aspect-[4/5]",
    widthClass: "w-[270px] md:w-[370px]",
    offset: "translate-y-4 md:translate-y-6"
  },
  {
    slug: "sunrays-on-the-blue-sea",
    name: "Sunrays on the blue sea",
    image: sunraysImg,
    aspect: "aspect-[4/3]", // Landscape horizontal
    widthClass: "w-[350px] md:w-[480px]",
    offset: "-translate-y-2 md:-translate-y-4"
  },
  {
    slug: "mckenna-hellam",
    name: "McKenna Hellam",
    image: mckennaImg,
    aspect: "aspect-[4/5]",
    widthClass: "w-[270px] md:w-[370px]",
    offset: "translate-y-2 md:translate-y-3"
  },
  {
    slug: "pensive-moment",
    name: "Pensive moment",
    image: pensiveImg,
    aspect: "aspect-[3/4]",
    widthClass: "w-[270px] md:w-[370px]",
    offset: "-translate-y-4 md:-translate-y-6"
  },
  {
    slug: "naked-woman-on-her-side",
    name: "Naked woman on her side",
    image: sideImg,
    aspect: "aspect-[4/3]", // Landscape horizontal
    widthClass: "w-[350px] md:w-[480px]",
    offset: "translate-y-0"
  }
];
---

<section class="horizontal-collection-section relative overflow-hidden border-t border-[var(--line)] pt-8 md:pt-12 pb-6 md:pb-8 flex flex-col justify-between md:h-screen md:min-h-[700px]">
  
  <!-- Static Title Header (stays on screen when section is pinned) -->
  <div class="mx-auto w-full max-w-screen-xl px-6 md:px-24 space-y-2 z-20">
    <p class="collection-tag text-[10px] md:text-xs uppercase tracking-[0.3em] text-[var(--charcoal-muted)] font-medium">
      Kolekcja Oryginałów 1/1
    </p>
    <h2 
      class="collection-title text-5xl sm:text-7xl lg:text-8xl xl:text-9xl font-serif leading-none tracking-tight pt-1"
      style="color: #151413 !important; font-weight: 400; font-variation-settings: 'wght' 400;"
    >
      The Collection
    </h2>
  </div>

  <!-- Horizontal scroll viewport container, grow takes up all available vertical space -->
  <div class="pin-wrap grow overflow-x-auto md:overflow-hidden scrollbar-none w-full mt-2 md:mt-0 flex items-center">
    <!-- 
      The scrollable container has the paper texture background. 
      As GSAP translates this container horizontally, the paper pattern scrolls horizontally 
      in perfect sync with the drawings, creating a continuous paper roll illusion.
    -->
    <div class="scroll-wrap flex flex-row items-center gap-10 md:gap-16 px-6 md:px-24 w-fit pt-2 md:pt-4 pb-6 md:pb-8" data-stagger-grid>
      
      <!-- 6 Drawing Cards with vertical height units for responsive auto-sizing -->
      {
        collectionItems.map((item) => (
          <div class={`flex flex-col space-y-2 cursor-pointer group transition-transform duration-500 shrink-0 w-fit ${item.offset}`}>
            <!-- Image in minimalist paper frame -->
            <a href={`/products/${item.slug}`} class="relative overflow-hidden bg-[var(--paper)] border border-[var(--charcoal-muted)]/10 p-4 transition-all duration-500 hover:shadow-xl block">
              <div class={`relative bg-[#faf8f5] overflow-hidden h-[30vh] md:h-[40vh] ${item.aspect}`}>
                <Image
                  src={item.image}
                  alt={item.name}
                  width={800}
                  height={1000}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
              </div>
            </a>
            <!-- Text title closer to drawing, using h2 tag, larger font size and bold variable weight -->
            <div class="flex justify-between items-baseline">
              <h2 
                class="text-base md:text-xl font-serif"
                style="font-variation-settings: 'wght' 620; -webkit-font-smoothing: antialiased; color: #1a1816 !important;"
              >
                {item.name}
              </h2>
            </div>
          </div>
        ))
      }

    </div>
  </div>

  <!-- Small bottom spacing to align flex layout nicely on desktop -->
  <div class="hidden md:block h-2"></div>
</section>

<!-- Hide horizontal scrollbar for mobile native swipes -->
<style is:global>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<!-- 
  Apply the exact same background and backdrop blur as the SiteHeader navigation 
  (bg-base/80 backdrop-blur-md) to blur out the body background vertical scroll.
-->
<style>
  .horizontal-collection-section {
    background-color: rgba(250, 248, 245, 0.8) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector(".horizontal-collection-section");
  const scrollWrap = document.querySelector(".scroll-wrap");
  const collectionTag = document.querySelector(".collection-tag");
  const collectionTitle = document.querySelector(".collection-title");

  // 2-etapowa animacja nagłówka: Najpierw wejście tekstu, a DOPIERO POTEM narastające pogrubienie (font-weight 400 -> 900)
  if (collectionTag && collectionTitle) {
    const headerTl = gsap.timeline({
      scrollTrigger: {
        trigger: collectionTag,
        start: "top 90%",
        end: "top 35%",
        scrub: 1,
      }
    });

    // Etap 1: Wejście tagu i tytułu (tak jak w reszcie strony)
    headerTl.fromTo(
      collectionTag,
      { y: 20, autoAlpha: 0 },
      { y: 0, autoAlpha: 1, duration: 1.0, ease: "power2.out" }
    );

    headerTl.fromTo(
      collectionTitle,
      {
        y: 28,
        autoAlpha: 0,
        fontWeight: 400,
        fontVariationSettings: "'wght' 400",
      },
      {
        y: 0,
        autoAlpha: 1,
        duration: 1.1,
        ease: "power2.out",
      },
      "-=0.7"
    );

    // Etap 2: DOPIERO POTEM pogrubienie (font-weight 400 -> 900), zaczynające się i kończące ciut wcześniej
    headerTl.to(
      collectionTitle,
      {
        fontWeight: 900,
        fontVariationSettings: "'wght' 900",
        duration: 1.5,
        ease: "power2.inOut",
      },
      "-=0.2"
    );
  }

  if (section && scrollWrap) {
    const mediaQuery = window.matchMedia("(min-width: 768px)");
    let triggerInstance: any = null;

    function initScrollTrigger() {
      if (mediaQuery.matches) {
        const scrollWidth = (scrollWrap as HTMLElement).scrollWidth;
        const windowWidth = window.innerWidth;
        const xTranslation = -(scrollWidth - windowWidth);

        // Pin the entire section, translate only the cards row
        triggerInstance = gsap.to(scrollWrap, {
          x: xTranslation,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            pin: true,
            scrub: 1,
            start: "top top",
            end: () => `+=${scrollWidth - windowWidth}`,
            invalidateOnRefresh: true,
          }
        });
      } else {
        if (triggerInstance) {
          triggerInstance.scrollTrigger.kill();
          triggerInstance = null;
        }
        gsap.set(scrollWrap, { clearProps: "all" });
      }
    }

    // Initialize and track resize changes
    initScrollTrigger();
    window.addEventListener("resize", () => {
      if (triggerInstance) {
        triggerInstance.scrollTrigger.kill();
        triggerInstance = null;
      }
      initScrollTrigger();
    });
  }
</script>
