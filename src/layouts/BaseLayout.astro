---
import "../styles.css";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";

const {
  title = "Jarek Sikorski art — Hand-made furniture from the northern woods",
  description = "A small Swedish atelier crafting solid oak, ash and walnut furniture by hand. Made to order in Småland.",
  image,
  noindex = false,
  includeHeader = true,
  includeFooter = true,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = image ? new URL(image.src ?? image, Astro.site ?? Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jarek Sikorski art" />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Jarek Sikorski art" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script is:inline>
      (() => {
        const storageKey = "atelier-ko-cart";

        function readCart() {
          try {
            return JSON.parse(window.localStorage.getItem(storageKey) || "[]");
          } catch {
            return [];
          }
        }

        function writeCart(items) {
          window.localStorage.setItem(storageKey, JSON.stringify(items));
          document.dispatchEvent(new CustomEvent("atelier-cart-change", { detail: items }));
        }

        function count(items = readCart()) {
          return items.reduce((total, item) => total + Number(item.quantity || 0), 0);
        }

        function updateBadges() {
          const total = count();
          document.querySelectorAll("[data-cart-count]").forEach((node) => {
            node.textContent = `(${total})`;
          });
          document.querySelectorAll("[data-cart-label]").forEach((node) => {
            node.setAttribute("aria-label", `Cart, ${total} ${total === 1 ? "item" : "items"}`);
          });
        }

        window.AtelierCart = {
          read: readCart,
          write: writeCart,
          count,
          add(slug, quantity = 1) {
            const items = readCart();
            const existing = items.find((item) => item.slug === slug);
            if (existing) {
              existing.quantity += quantity;
              writeCart(items);
              return;
            }
            writeCart([...items, { slug, quantity }]);
          },
          remove(slug) {
            writeCart(readCart().filter((item) => item.slug !== slug));
          },
          setQuantity(slug, quantity) {
            if (quantity <= 0) {
              this.remove(slug);
              return;
            }
            writeCart(readCart().map((item) => (item.slug === slug ? { ...item, quantity } : item)));
          },
          updateBadges,
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", updateBadges);
        } else {
          updateBadges();
        }
        window.addEventListener("storage", updateBadges);
        document.addEventListener("atelier-cart-change", updateBadges);
      })();
    </script>
  </head>
  <body class="bg-base text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-base)]"
    >
      Skip to content
    </a>
    {includeHeader && <SiteHeader currentPath={Astro.url.pathname} />}
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
        {includeFooter && <SiteFooter />}
      </div>
    </div>
  </body>
</html>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  gsap.registerPlugin(ScrollTrigger, SplitText, ScrollSmoother);

  // Expose GSAP globally for inline scripts (e.g. catalog filtering)
  (window as any).gsap = gsap;
  (window as any).ScrollTrigger = ScrollTrigger;

  // Initialize GSAP ScrollSmoother for silky smooth momentum scrolling
  function initSmoother() {
    if (window.innerWidth >= 768 && !window.matchMedia("(pointer: coarse)").matches) {
      ScrollSmoother.create({
        wrapper: "#smooth-wrapper",
        content: "#smooth-content",
        smooth: 1.2,
        effects: true,
        smoothTouch: 0.1
      });
    }
  }

  // Setup ScrollTrigger reveal animations (Elastic Wave Reveal using SplitText for text paragraphs)
  function initTextReveals() {
    const targets = document.querySelectorAll(
      "main p:not(.sr-only):not(.hero-title p):not(.manifesto-section p):not(.education-contact-section footer p):not(nav p):not(.scroll-wrap p)"
    );

    targets.forEach((target) => {
      const htmlEl = target as HTMLElement;
      
      // Split text into lines (single level)
      const split = new SplitText(htmlEl, {
        type: "lines",
        linesClass: "line-inner block origin-top-left"
      });

      // Animate lines using the gbgeaZM Pen parameters
      gsap.from(split.lines, {
        y: 20,
        rotation: 5,
        opacity: 0,
        transformOrigin: "0% 0%",
        duration: 1.3,
        stagger: 0.18,
        ease: "back.out(1)",
        scrollTrigger: {
          trigger: htmlEl,
          start: "top 88%",
          toggleActions: "play none none reverse"
        }
      });
    });
  }

  // Setup stagger reveal for horizontal multi-block containers (animates items on scroll as they enter viewport)
  function initStaggerGrids() {
    const gridContainers = document.querySelectorAll("[data-stagger-grid]");

    gridContainers.forEach((container) => {
      const items = Array.from(container.children).filter(
        (child) => getComputedStyle(child).display !== "none"
      );
      const customStart = (container as HTMLElement).dataset.staggerStart || "top 88%";

      if (items.length > 0) {
        gsap.set(items, { y: 32, opacity: 0 });

        ScrollTrigger.batch(items, {
          start: customStart,
          once: true,
          onEnter: (batch) => {
            gsap.to(batch, {
              y: 0,
              opacity: 1,
              duration: 0.95,
              stagger: 0.22,
              ease: "power2.out",
              clearProps: "transform,opacity"
            });
          }
        });
      }
    });
  }

  // Execute on document ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initSmoother();
      initTextReveals();
      initStaggerGrids();
    });
  } else {
    initSmoother();
    initTextReveals();
    initStaggerGrids();
  }

  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
  });
</script>
