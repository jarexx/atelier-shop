---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import heroImg from "@/assets/header-interior-portrait_babcia-1-1536x1295.webp";
import ManifestoSection from "@/components/home/ManifestoSection.astro";
import CollectionSection from "@/components/home/CollectionSection.astro";
import CommissionsSection from "@/components/home/CommissionsSection.astro";
import EducationContactSection from "@/components/home/EducationContactSection.astro";
---

<BaseLayout
  title="Jarek Sikorski Atelier — drawings and art made by hand"
  description="A small catalogue of seating, tables and storage. Solid oak, ash and walnut, hand-built to order in Småland, Sweden."
  image={heroImg}
  includeFooter={false}
>
  <main id="main-content">
    <h1 class="sr-only">Jarek Sikorski Atelier — drawings and art made by hand</h1>
    <section class="relative overflow-hidden">
      <div class="md:hidden">
        <div class="aspect-[4/3] w-full">
          <Image
            src={heroImg}
            alt="Hand-carved sculptural walnut lounge chair in a sunlit atelier"
            width={1536}
            height={1295}
            format="webp"
            loading="eager"
            decoding="sync"
            class="h-full w-full object-cover object-right"
          />
        </div>
        <div class="space-y-6 px-6 py-12">
          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            Småland, Sweden · Est. 2018
          </p>
          <p class="text-balance font-serif text-4xl leading-[1.1] hero-title">
            <span class="hero-line block" data-hero-line>Hand-carved pieces</span>
            <span class="hero-line block italic text-accent" data-hero-line>from the northern woods.</span>
          </p>
          <p class="max-w-[48ch] text-pretty leading-relaxed text-faded">
            A small, slow catalogue of seating, tables and storage — solid oak, ash and walnut,
            shaped by hand and built to outlast the room they were made for.
          </p>
          <div class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center">
            <a
              href="/catalog"
              class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              Browse the catalogue
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1"
                >→</span
              >
            </a>
            <a
              href="/about"
              class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
            >
              Our workshop →
            </a>
          </div>
        </div>
      </div>

      <div class="relative hidden h-[calc(100vh-4rem)] min-h-[600px] md:h-[calc(100vh-4rem)] md:min-h-[750px] w-full md:block">
        <Image
          src={heroImg}
          alt="Hand-carved sculptural walnut lounge chair in a sunlit atelier"
          width={1536}
          height={1295}
          format="webp"
          loading="eager"
          decoding="sync"
          class="absolute inset-0 h-full w-full object-cover"
          style="object-position: 100% 65%"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0"
          style="background: linear-gradient(90deg, var(--color-base) 0%, var(--color-base) 30%, color-mix(in oklab, var(--color-base) 55%, transparent) 45%, color-mix(in oklab, var(--color-base) 5%, transparent) 65%, transparent 80%)"
        >
        </div>
        <div
          aria-hidden="true"
          class="absolute inset-x-0 bottom-0 h-40"
          style="background: linear-gradient(180deg, transparent, var(--color-base))"
        >
        </div>
        <div class="relative mx-auto flex h-full max-w-screen-xl items-center px-6">
          <div class="max-w-[480px] space-y-8">
            <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
              <span class="inline-block h-px w-8 bg-ink/40"></span>
              Småland, Sweden · Est. 2018
            </p>
            <p class="text-balance font-serif text-5xl leading-[1.1] lg:text-6xl hero-title">
              <span class="hero-line block" data-hero-line>Hand-carved pieces</span>
              <span class="hero-line block italic text-accent" data-hero-line>from the northern woods.</span>
            </p>
            <p class="max-w-[48ch] text-pretty leading-relaxed text-faded md:text-lg">
              A small, slow catalogue of seating, tables and storage — solid oak, ash and walnut,
              shaped by hand and built to outlast the room they were made for.
            </p>
            <div class="flex items-center gap-6 pt-2">
              <a
                href="/catalog"
                class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
              >
                Browse the catalogue
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1"
                  >→</span
                >
              </a>
              <a
                href="/about"
                class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
              >
                Our workshop →
              </a>
            </div>
          </div>
        </div>
        <div
          class="absolute bottom-10 right-10 hidden flex-col items-end gap-1 text-[10px] uppercase tracking-[0.3em] text-ink/70 md:flex"
        >
          <span>No. 04 — Arvid Lounge</span>
          <span class="text-faded">Solid Walnut · 2025</span>
        </div>
      </div>
    </section>

    <ManifestoSection />
    <CollectionSection />
    <CommissionsSection />
    <EducationContactSection />
  </main>
</BaseLayout>

<style>
  .hero-title :global(.hero-char) {
    font-family: var(--font-serif);
    font-variation-settings: 'wght' var(--char-wght, 400);
    display: inline-block;
    white-space: pre;
    will-change: font-variation-settings;
  }
</style>

<script>
  import { gsap } from "gsap";

  // Find all elements marked as data-hero-line
  const lines = document.querySelectorAll("[data-hero-line]");

  lines.forEach((line) => {
    const text = (line.textContent || "").trim();
    line.innerHTML = "";
    
    for (let char of text) {
      const span = document.createElement("span");
      span.textContent = char;
      span.className = "hero-char";
      line.appendChild(span);
    }
  });

  // Run letter bolding animation line by line on load
  const tl = gsap.timeline({ delay: 0.25 });

  const line1Chars = document.querySelectorAll(".hero-title span:first-child .hero-char");
  const line2Chars = document.querySelectorAll(".hero-title span:last-child .hero-char");

  tl.to(line1Chars, {
    "--char-wght": 720,
    duration: 1.0,
    stagger: 0.035,
    ease: "power2.out"
  });

  tl.to(line2Chars, {
    "--char-wght": 720,
    duration: 1.0,
    stagger: 0.035,
    ease: "power2.out"
  }, "-=0.7");
</script>
