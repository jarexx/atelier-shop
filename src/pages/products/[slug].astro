---
import { Image } from "astro:assets";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPrice, getProducts, getRelated } from "@/data/products.js";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, related: getRelated(products, product.slug) },
  }));
}

const { product, related } = Astro.props;
const productUrl = new URL(`/products/${product.slug}`, Astro.site ?? Astro.url.origin).href;

function formatDimensions(dimStr: string) {
  if (!dimStr || dimStr.toLowerCase().includes("request") || dimStr.trim() === "") return null;
  
  // Try to match W 29 × H 41 cm or similar
  const match = dimStr.match(/W\s*(\d+(?:\.\d+)?)\s*×\s*H\s*(\d+(?:\.\d+)?)/i);
  if (match) {
    const wCm = parseFloat(match[1]);
    const hCm = parseFloat(match[2]);
    const wIn = (wCm * 0.393701).toFixed(1);
    const hIn = (hCm * 0.393701).toFixed(1);
    return {
      cm: `${wCm} × ${hCm} cm`,
      inches: `${wIn} × ${hIn} in`
    };
  }
  
  // Try to match other formats like 29x41 or 29 x 41
  const match2 = dimStr.match(/(\d+(?:\.\d+)?)\s*(?:x|×)\s*(\d+(?:\.\d+)?)/i);
  if (match2) {
    const wCm = parseFloat(match2[1]);
    const hCm = parseFloat(match2[2]);
    const wIn = (wCm * 0.393701).toFixed(1);
    const hIn = (hCm * 0.393701).toFixed(1);
    return {
      cm: `${wCm} × ${hCm} cm`,
      inches: `${wIn} × ${hIn} in`
    };
  }
  
  return { cm: dimStr, inches: null };
}
---

<BaseLayout
  title={`${product.name} — Jarek Sikorski art`}
  description={product.description.slice(0, 155)}
  image={product.images[0]}
>
  <main id="main-content">
  <div class="mx-auto max-w-screen-xl px-6 pt-8">
    <nav class="flex gap-2 text-xs uppercase tracking-widest text-faded" aria-label="Breadcrumb">
      <a href="/catalog" class="hover:text-ink">Catalogue</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink" aria-current="page">{product.name}</span>
    </nav>
  </div>

  <div class="mx-auto max-w-screen-xl px-6 py-12">
    <section class="grid grid-cols-1 items-start gap-16 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-7" data-product-gallery>
        <div class="relative overflow-hidden bg-white p-4 sm:p-6 md:p-8 shadow-md border border-[var(--border-subtle)]">
          {
            product.images.map((image, index) => (
              <div
                class:list={[index !== 0 && "hidden", "w-full flex justify-center items-center cursor-zoom-in group/zoom"]}
                data-gallery-panel={index}
                data-open-lightbox={index}
                title="Kliknij, aby otworzyć pełnoekranową galerię"
              >
                <Image
                  src={image}
                  alt={`${product.name} — view ${index + 1}`}
                  width={1440}
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                  class="atelier-fade-in w-full h-auto max-h-[85vh] object-contain transition-transform duration-500 group-hover/zoom:scale-[1.015]"
                />
              </div>
            ))
          }
        </div>
        <div class="grid grid-cols-3 gap-4">
          {
            product.images.map((image, index) => (
              <button
                type="button"
                class:list={[
                  "aspect-square overflow-hidden bg-white p-1.5 ring-1 transition-all cursor-pointer",
                  index === 0 ? "ring-ink" : "ring-line hover:ring-ink/40",
                ]}
                data-gallery-thumb={index}
                aria-label={`Show view ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <Image src={image} alt="" width={360} format="webp" loading="lazy" class="h-full w-full object-contain" />
              </button>
            ))
          }
        </div>
      </div>

      <div class="space-y-12 lg:sticky lg:top-24 lg:col-span-5">
        <div class="space-y-4">
          <div class="text-xs uppercase tracking-widest text-faded">{product.collection}</div>
          <h1 class="text-balance font-serif text-4xl leading-tight md:text-5xl">{product.name}</h1>
          {product.leadTime !== "Private Collection" && (
            <p class="font-serif text-2xl">{formatPrice(product.price)}</p>
          )}
        </div>

        <div class="space-y-6">
          <p class="max-w-[44ch] text-pretty leading-relaxed text-faded">{product.description}</p>
          <div class="space-y-2 pt-4 text-sm border-t border-line">
            <p><span class="text-faded">Medium:</span> {product.material}</p>
            {(() => {
              const formatted = formatDimensions(product.dimensions);
              if (!formatted) return null;
              return (
                <p class="select-none">
                  <span class="text-faded">Dimensions:</span>{" "}
                  {formatted.inches ? (
                    <span data-dim-toggle class="cursor-pointer inline-flex items-center gap-1 group/dim">
                      <span data-dim-primary>{formatted.cm}</span>
                      <span data-dim-secondary class="text-faded text-xs transition-colors group-hover/dim:text-ink/60">({formatted.inches})</span>
                    </span>
                  ) : (
                    <span>{formatted.cm}</span>
                  )}
                </p>
              );
            })()}
            <p><span class="text-faded">Status:</span> {product.leadTime}</p>
          </div>
        </div>

        {product.leadTime !== "Private Collection" && (
          <button
            type="button"
            data-add-to-cart={product.slug}
            class="w-full rounded-full bg-ink py-4 text-sm font-medium text-[var(--color-base)] ring-1 ring-ink transition-all hover:bg-accent hover:ring-accent active:scale-[0.98]"
          >
            Add to Collection
          </button>
        )}

        <p class="text-[11px] uppercase tracking-widest text-faded">
          Free white-glove delivery in EU · Worldwide on request
        </p>
      </div>
    </section>

    <section class="mt-40 space-y-12 border-t border-line pt-16">
      <div class="flex items-end justify-between gap-6">
        <h2 class="font-serif text-3xl md:text-4xl">Pieces that sit well together</h2>
        <a href="/catalog" class="text-xs uppercase tracking-widest underline underline-offset-4 hover:text-accent">
          View all
        </a>
      </div>
      <div class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3">
        {related.map((item) => <ProductCard product={item} />)}
      </div>
    </section>
  </div>

  <!-- Fullscreen Lightbox Modal -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 hidden bg-[var(--charcoal-black)]/95 backdrop-blur-md flex-col justify-between p-4 sm:p-8"
    aria-hidden="true"
  >
    <!-- Top bar: image counter and close button -->
    <div class="flex justify-between items-center text-[var(--old-lace)] z-10 w-full max-w-screen-xl mx-auto">
      <span id="lightbox-counter" class="text-xs uppercase tracking-widest font-mono text-[var(--dim-grey-light)]">
        1 / {product.images.length}
      </span>
      <button
        id="lightbox-close"
        type="button"
        class="p-2 text-xs uppercase tracking-[0.2em] font-semibold text-[var(--old-lace)] hover:text-[var(--sanguine)] transition-colors cursor-pointer"
        aria-label="Close gallery"
      >
        Zamknij ✕
      </button>
    </div>

    <!-- Main image viewport with prev/next buttons -->
    <div class="relative flex-1 flex items-center justify-center p-2 sm:p-6 overflow-hidden my-auto">
      {product.images.length > 1 && (
        <button
          id="lightbox-prev"
          type="button"
          class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 z-20 p-3.5 rounded-full bg-[var(--charcoal-black)]/80 text-[var(--old-lace)] border border-white/10 hover:bg-[var(--sanguine)] hover:border-[var(--sanguine)] transition-all cursor-pointer"
          aria-label="Previous image"
        >
          ←
        </button>
      )}

      <div class="relative max-w-full max-h-full flex items-center justify-center p-3 sm:p-6 bg-white border border-white/20 shadow-2xl">
        {product.images.map((image, idx) => (
          <div
            class:list={["lightbox-panel", idx !== 0 && "hidden", "max-w-full max-h-[82vh] flex items-center justify-center"]}
            data-lightbox-index={idx}
          >
            <Image
              src={image}
              alt={`${product.name} — view ${idx + 1}`}
              width={2000}
              format="webp"
              loading="lazy"
              class="max-w-full max-h-[78vh] w-auto h-auto object-contain select-none"
            />
          </div>
        ))}
      </div>

      {product.images.length > 1 && (
        <button
          id="lightbox-next"
          type="button"
          class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 z-20 p-3.5 rounded-full bg-[var(--charcoal-black)]/80 text-[var(--old-lace)] border border-white/10 hover:bg-[var(--sanguine)] hover:border-[var(--sanguine)] transition-all cursor-pointer"
          aria-label="Next image"
        >
          →
        </button>
      )}
    </div>

    <!-- Bottom caption -->
    <div class="text-center text-[10px] text-[var(--dim-grey-light)] uppercase tracking-[0.2em] z-10 w-full">
      {product.name} · Jarek Sikorski art
    </div>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.name,
    description: product.description,
    image: product.images.map((image) => new URL(image.src, Astro.url.origin).href),
    brand: {
      "@type": "Brand",
      name: "Jarek Sikorski art",
    },
    material: product.material,
    url: productUrl,
    offers: {
      "@type": "Offer",
      priceCurrency: "USD",
      price: product.price,
      availability: "https://schema.org/PreOrder",
      url: productUrl,
    },
  })}></script>

  <script>
    import { gsap } from "gsap";

    const gallery = document.querySelector("[data-product-gallery]");
    if (gallery) {
      const panels = Array.from(gallery.querySelectorAll("[data-gallery-panel]"));
      const thumbs = Array.from(gallery.querySelectorAll("[data-gallery-thumb]"));

      thumbs.forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const active = (thumb as HTMLElement).dataset.galleryThumb;
          panels.forEach((panel) => (panel as HTMLElement).classList.toggle("hidden", (panel as HTMLElement).dataset.galleryPanel !== active));
          thumbs.forEach((button) => {
            const selected = (button as HTMLElement).dataset.galleryThumb === active;
            button.classList.toggle("ring-ink", selected);
            button.classList.toggle("ring-line", !selected);
            button.setAttribute("aria-pressed", selected ? "true" : "false");
          });
        });
      });
    }

    const addButton = document.querySelector("[data-add-to-cart]");
    if (addButton) {
      const originalText = addButton.textContent;
      let timer: number;
      addButton.addEventListener("click", () => {
        // @ts-ignore
        if (window.AtelierCart) {
          // @ts-ignore
          window.AtelierCart.add((addButton as HTMLElement).dataset.addToCart, 1);
        }
        addButton.textContent = "Added to your archive →";
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          addButton.textContent = originalText;
        }, 1800);
      });
    }

    // Dynamic Dimensions interactive toggle with Scramble Effect & LocalStorage
    const toggle = document.querySelector("[data-dim-toggle]");
    if (toggle) {
      const primary = toggle.querySelector("[data-dim-primary]");
      const secondary = toggle.querySelector("[data-dim-secondary]");
      
      if (primary && secondary) {
        const cmText = primary.textContent || "";
        const inText = (secondary.textContent || "").replace(/[()]/g, "").trim();
        
        // Custom Scramble Effect
        const scramble = (element: HTMLElement, targetText: string) => {
          const glyphs = "0123456789×.in cm";
          const length = targetText.length;
          const frames = 12;
          let frame = 0;
          
          const interval = setInterval(() => {
            frame++;
            let currentText = "";
            for (let i = 0; i < length; i++) {
              if (Math.random() < frame / frames) {
                currentText += targetText[i];
              } else {
                currentText += glyphs[Math.floor(Math.random() * glyphs.length)];
              }
            }
            element.textContent = currentText;
            if (frame >= frames) {
              clearInterval(interval);
              element.textContent = targetText;
            }
          }, 16);
        };

        const updateUI = (unit: 'cm' | 'in', animate = true) => {
          const primTarget = unit === 'cm' ? cmText : inText;
          const secTarget = unit === 'cm' ? `(${inText})` : `(${cmText})`;
          
          if (animate) {
            scramble(primary as HTMLElement, primTarget);
            scramble(secondary as HTMLElement, secTarget);
          } else {
            primary.textContent = primTarget;
            secondary.textContent = secTarget;
          }
        };

        // 1. Initial State Check (LocalStorage or Auto-detect)
        let savedUnit = localStorage.getItem("user-dimension-unit") as 'cm' | 'in' | null;
        if (!savedUnit) {
          // Auto-detect based on US locale
          const isUS = navigator.language === 'en-US' || (navigator.languages && navigator.languages.includes('en-US'));
          savedUnit = isUS ? 'in' : 'cm';
          localStorage.setItem("user-dimension-unit", savedUnit);
        }
        
        // Apply initial state without animation on page load
        updateUI(savedUnit, false);
        
        // 2. Click Handler
        toggle.addEventListener("click", () => {
          const currentUnit = localStorage.getItem("user-dimension-unit") || 'cm';
          const newUnit = currentUnit === 'cm' ? 'in' : 'cm';
          localStorage.setItem("user-dimension-unit", newUnit);
          updateUI(newUnit, true);
        });
      }
    }

    // Lightbox Modal Interactive Logic
    const lightboxModal = document.getElementById("lightbox-modal");
    const lightboxClose = document.getElementById("lightbox-close");
    const lightboxPrev = document.getElementById("lightbox-prev");
    const lightboxNext = document.getElementById("lightbox-next");
    const lightboxCounter = document.getElementById("lightbox-counter");
    const lightboxPanels = Array.from(document.querySelectorAll("[data-lightbox-index]"));
    const openTriggers = Array.from(document.querySelectorAll("[data-open-lightbox]"));

    let currentLightboxIdx = 0;

    function showLightboxIndex(idx: number) {
      if (lightboxPanels.length === 0) return;
      currentLightboxIdx = (idx + lightboxPanels.length) % lightboxPanels.length;

      lightboxPanels.forEach((panel, i) => {
        panel.classList.toggle("hidden", i !== currentLightboxIdx);
      });

      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentLightboxIdx + 1} / ${lightboxPanels.length}`;
      }
    }

    function openLightbox(idx: number) {
      if (!lightboxModal) return;
      showLightboxIndex(idx);
      lightboxModal.classList.remove("hidden");
      lightboxModal.classList.add("flex");
      lightboxModal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!lightboxModal) return;
      lightboxModal.classList.add("hidden");
      lightboxModal.classList.remove("flex");
      lightboxModal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    openTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const idx = parseInt((trigger as HTMLElement).dataset.openLightbox || "0", 10);
        openLightbox(idx);
      });
    });

    if (lightboxClose) {
      lightboxClose.addEventListener("click", closeLightbox);
    }

    if (lightboxPrev) {
      lightboxPrev.addEventListener("click", () => showLightboxIndex(currentLightboxIdx - 1));
    }

    if (lightboxNext) {
      lightboxNext.addEventListener("click", () => showLightboxIndex(currentLightboxIdx + 1));
    }

    document.addEventListener("keydown", (e) => {
      if (!lightboxModal || lightboxModal.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") showLightboxIndex(currentLightboxIdx - 1);
      if (e.key === "ArrowRight") showLightboxIndex(currentLightboxIdx + 1);
    });

    if (lightboxModal) {
      lightboxModal.addEventListener("click", (e) => {
        if (e.target === lightboxModal) {
          closeLightbox();
        }
      });
    }
  </script>
  </main>
</BaseLayout>
